# Copie para .env.local e preencha. Nunca commite o .env.local.

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor. Usada para visitantes sem conta, simulador e atendente.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── IA do atendente (opcional) ──
# Sem chave, o atendente roda em "modo roteiro" (fluxos guiados, sem IA).
# Use uma chave de API do console.anthropic.com (não o token de assinatura do Claude Code).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_SLUG=easywash
# mock = Cicclo, Stone e câmeras simulados (único modo disponível no protótipo)
INTEGRATIONS_MODE=mock
